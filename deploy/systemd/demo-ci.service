[Unit]
Description=demo-ci Spring Boot Application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/service/demo-ci
EnvironmentFile=-/home/ec2-user/service/demo-ci/env.conf
# JVM 옵션은 env.conf 의 JAVA_TOOL_OPTIONS 로 전달
ExecStart=/usr/bin/java -jar /home/ec2-user/service/demo-ci/app.jar
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=mixed
SuccessExitStatus=143
StandardOutput=journal
StandardError=journal
SyslogIdentifier=demo-ci

[Install]
WantedBy=multi-user.target
